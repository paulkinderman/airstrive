{
  "expo": {
    "name": "AirStrive",
    "slug": "airstrive",
    "version": "0.1.0",
    "scheme": "airstrive",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F5B61C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.airstrive.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "AirStrive uses your photos to keep the moments you log.",
        "NSCameraUsageDescription": "AirStrive uses the camera to capture a moment as it happens."
      }
    },
    "android": {
      "package": "app.airstrive.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5B61C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "AirStrive uses your photos to keep the moments you log.",
          "cameraPermission": "AirStrive uses the camera to capture a moment as it happens."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "paulkinderman"
  }
}
