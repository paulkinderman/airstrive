# Copy to .env (never commit .env). EXPO_PUBLIC_ values are bundled into the app and are
# safe to ship: the anon / publishable key only works within the row-level security rules.

# Supabase project settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Google sign-in (optional; leave blank for Apple-only on iOS).
# Web client id: Google Cloud → Credentials → OAuth client (Web). Also add it to Supabase → Auth → Google.
# The website uses it too: add https://<site>/app/ to the client's authorized redirect URIs and set
# this variable in Vercel, and Google's account picker names the site instead of the Supabase project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client id: Google Cloud → Credentials → OAuth client (iOS, bundle id app.airstrive.mobile).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
