# Copy to .env.local (never commit it). Same Supabase project as the app's
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY. The anon / publishable key is
# safe in the browser: every admin action is checked server-side by is_admin().
# Never put a service role key here.

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key
